// use prisma-8

model User {
  id           Int      @id @default(autoincrement())
  roleId       Int
  username     String   @unique
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}